APP_NAME="El Jardín de tu Salud API"
APP_ENV=development
APP_DEBUG=false

CORS_ORIGINS=["http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true
SESSION_COOKIE_NAME=jardin_session
SESSION_DURATION_HOURS=8
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

DATABASE_URL="postgresql+psycopg://usuario:clave@localhost:5432/jardin_dev"
TEST_DATABASE_URL="postgresql+psycopg://usuario:clave@localhost:5432/tia_richrad_test"
